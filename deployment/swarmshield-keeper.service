[Unit]
Description=SwarmShield Dark Pool Keeper Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=swarmshield
Group=swarmshield
WorkingDirectory=/opt/swarmshield/keeper
Environment="NODE_ENV=production"
EnvironmentFile=/opt/swarmshield/keeper/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=append:/var/log/swarmshield/keeper.log
StandardError=append:/var/log/swarmshield/keeper-error.log

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/swarmshield
ReadOnlyPaths=/opt/swarmshield

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
