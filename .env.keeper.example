# SwarmShield Keeper Configuration

# Solana RPC URL
RPC_URL=https://api.devnet.solana.com

# Keeper wallet private key (same as protocol authority)
# Get this from: solana-keygen pubkey ~/.config/solana/id.json --outfile keypair.json
# Then copy the array here
KEEPER_PRIVATE_KEY=[YOUR_KEYPAIR_ARRAY_HERE]

# Poll interval (milliseconds)
POLL_INTERVAL_MS=5000
