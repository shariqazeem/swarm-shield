# Solana RPC URL (devnet)
RPC_URL=https://api.devnet.solana.com

# Keeper wallet private key (JSON array format)
# This should be the same wallet that initialized the protocol
KEEPER_PRIVATE_KEY=[1,2,3,...] # Your keeper keypair secret key as array

# Poll interval in milliseconds (how often to check for pending intents)
POLL_INTERVAL_MS=5000
